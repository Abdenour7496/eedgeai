# Copy to .env and replace secrets before exposing the stack.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COPILOT_API_KEY=

# Main chat backend: openclaw | openai | anthropic | ollama | copilot
LLM_BACKEND=openclaw
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# Graphiti knowledge graph. Defaults are fully local through Ollama.
# Qwen 2.5 7B is used because Graphiti requires reliable structured JSON.
GRAPHITI_API_BASE_URL=http://ollama:11434/v1
GRAPHITI_API_KEY=ollama
GRAPHITI_MODEL=qwen2.5:7b
GRAPHITI_EMBEDDING_MODEL=nomic-embed-text
GRAPHITI_EMBEDDING_DIM=768
GRAPHITI_GROUP_ID=documents
GRAPHITI_TOP_K=8
ENABLE_RAG=true

# FalkorDB
FALKORDB_DATABASE=eedgeai
FALKORDB_PASSWORD=

# Ollama chat/vision defaults
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b

# OpenClaw
OPENCLAW_GATEWAY_TOKEN=replace-me
OPENCLAW_GATEWAY_PASSWORD=replace-me
TELEGRAM_BOT_TOKEN=

# Document originals (SeaweedFS S3 store; the same keys are the S3 admin identity)
DOCS_S3_ACCESS_KEY=gcor_docs
DOCS_S3_SECRET_KEY=replace-me
DOCS_S3_BUCKET=documents
OPENWEBUI_S3_BUCKET=openwebui
# Admin UI on :9001 — leave empty to keep it bound to localhost inside the container
SEAWEEDFS_ADMIN_PASSWORD=
# INGEST_WATCH_INTERVAL_SECONDS=10
# INGEST_ENABLE_DOCINT=false

# Edge TTS
TTS_API_KEY=tts-local
TTS_DEFAULT_VOICE=en-US-AriaNeural
TTS_DEFAULT_FORMAT=mp3
