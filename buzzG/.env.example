# Docker network that Buzz's Compose stack created.
# Run: docker network ls  — look for the network ending in _default or buzz_default.
BUZZ_NETWORK=buzz_default

# ── Postgres (Buzz's existing instance) ──────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=buzz
POSTGRES_PASSWORD=buzz
POSTGRES_DB=buzz

# ── MinIO (Buzz's existing instance) ─────────────────────────────────────────
MINIO_HOST=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=gcor-objects
MINIO_SECURE=false

# ── Embedding ─────────────────────────────────────────────────────────────────
# Backend: openai | ollama
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# Required when EMBEDDING_BACKEND=openai
OPENAI_API_KEY=sk-...

# Required when EMBEDDING_BACKEND=ollama
OLLAMA_BASE_URL=http://ollama:11434

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret for inbound webhook calls from buzz-workflow.
# Leave blank to disable secret checking.
INGEST_WEBHOOK_SECRET=change-me

# ── MCP server ────────────────────────────────────────────────────────────────
GCOR_PROXY_URL=http://gcor-proxy:5001
